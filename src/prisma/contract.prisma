// use prisma-8

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("user")
  createdAt DateTime @default(now())
}

model Session {
  id               Int      @id @default(autoincrement())
  userId           Int
  refreshTokenHash String   @unique
  expiresAt        DateTime
  createdAt        DateTime @default(now())
}
